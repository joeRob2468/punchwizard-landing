# Copy to .env. Nothing here is secret.

# Apex domain the site is served at (server overlay only), e.g. example.com.
DOMAIN=example.com

# Host port for local runs (bound to 127.0.0.1).
PORT=8080

# On the home server only: layer the Traefik overlay on top.
# COMPOSE_FILE=compose.yaml:compose.server.yaml
