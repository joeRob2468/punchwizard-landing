{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    // CSS Modules are typed as an index signature; allow `styles.foo`.
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src"]
}
